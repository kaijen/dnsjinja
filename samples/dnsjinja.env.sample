# Am besten als $HOME/.dnsjinja/dnsjinja.env abspeichern
# DATADIR und CONFIG auf die Verzeichnisse zeigen lassen, in denen die Daten ausgecheckt wurden

# Token des in config.json gewählten DNS-Backends.
# Vorrang hat DNSJINJA_<BACKEND>_AUTH_API_TOKEN, siehe unten.
DNSJINJA_AUTH_API_TOKEN=<API-Token des DNS-Backends>

# Token je Backend - nötig, wenn mehrere Anbieter parallel betrieben werden.
# Hetzner: aus der Cloud Console, Projekt -> Security -> API Tokens (Read & Write).
#          Das alte Auth-API-Token von dns.hetzner.com funktioniert NICHT.
# DNSJINJA_HETZNER_AUTH_API_TOKEN=<API-Token aus der Hetzner Cloud Console>
# deSEC: im deSEC-Konto unter Token Management.
# DNSJINJA_DESEC_AUTH_API_TOKEN=<API-Token aus dem deSEC-Konto>

DNSJINJA_DATADIR=d:/gitlab.secorvo.de/DNSJinja-Templates-Secorvo
DNSJINJA_CONFIG=${DNSJINJA_DATADIR}/config/config.json

# Basis-URL überschreiben (Standard: die des gewählten Backends)
# DNSJINJA_API_BASE=https://api.hetzner.cloud/v1
